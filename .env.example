APP_ENV=production
APP_URL=https://forms.example.com

MAILER_DSN=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=username
SMTP_PASSWORD=password
MAIL_FROM=forms@example.com
MAIL_FROM_NAME=formflow

TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_SITE_KEY=your-turnstile-site-key
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_PATH=storage/submissions.sqlite
IP_HASH_SECRET=replace-with-a-long-random-value
RETENTION_DAYS=180
MAIL_DELIVERY_MODE=sync
# Total attempts per email retry cycle; a manual retry starts a new cycle
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_DELAY_SECONDS=60
MAIL_RETRY_MAX_DELAY_SECONDS=3600
# Queue delivery keeps form requests independent of webhook latency. Run
# `php bin/formflow webhooks:retry` from cron or a worker when this is enabled.
WEBHOOK_DELIVERY_MODE=queue

# Wrap the hash in single quotes -- it contains `$` characters that Dotenv would
# otherwise try to interpolate as variable references, silently corrupting it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2y$12$replace-with-a-real-bcrypt-hash'
ADMIN_TOTP_SECRET=
RECOVERY_TOKEN_HASH=

# Optional read-only analytics API token (keep on the calling server, never in browser JS)
ANALYTICS_API_TOKEN=

# Optional private delivery monitoring API (separate from the analytics token)
OPERATIONS_API_TOKEN=
# Alert when pending work or its last successful worker run is this old
DELIVERY_QUEUE_MAX_AGE_SECONDS=900
DELIVERY_WORKER_MAX_AGE_SECONDS=900
DELIVERY_FAILED_THRESHOLD=1
# Optional cron email alerts: php bin/formflow delivery:check --notify
DELIVERY_ALERT_EMAIL=
