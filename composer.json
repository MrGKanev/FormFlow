{
  "name": "formflow/formflow",
  "description": "Minimal self-hosted PHP form backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "symfony/dotenv": "^7.0",
    "symfony/mailer": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "formflow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "formflow\\Tests\\": "tests/"
    }
  }
}
